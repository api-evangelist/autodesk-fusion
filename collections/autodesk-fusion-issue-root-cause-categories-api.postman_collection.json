          "name": "Your GET endpoint",
          "request": {
            "name": "Your GET endpoint",
            "description": {
              "content": "Retrieves a list of supported root cause categories and root causes that you can allocate to an issue. For example, communication and coordination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "construction",
                "issues",
                "v1",
                "projects",
                ":projectId",
                "issue-root-cause-categories"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "include",
                  "value": "<string>",
                  "description": "Add ‘include=rootcauses’ to add the root causes for each category."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Add limit=20 to limit the results count (together with the offset to support pagination)."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Add offset=20 to get partial results (together with the limit to support pagination)"
                },
                {
                  "disabled": false,
                  "key": "filter[updatedAt]",
                  "value": "<string>",
                  "description": "Retrieves root cause categories updated at the specified date and time, in one of the following URL-encoded formats: YYYY-MM-DDThh:mm:ss.sz or YYYY-MM-DD. Separate multiple values with commas."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "projectId",
                  "description": "(Required) The ID of the project."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "key": "x-ads-region",
                "value": "<string>",
                "description": ""
              },
