            "description": {
              "content": "Enables or disables a service account.\n\nWhen a service account is in a disabled state, it loses its capability to manage its service account key.\nAssertions signed by the key will be treated as invalid.\n\nThis operation allows enabling a service account that is in a deactivated state.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "authentication",
